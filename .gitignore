*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
env/
venv/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
